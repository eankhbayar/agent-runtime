{
  "name": "@eankhbayar/agent-runtime",
  "version": "0.3.0",
  "description": "Runtimes for sandboxed coding agents: the run-event contract, executeRun and the store interfaces, a Docker sandbox provider, the egress gateway, and the pi runtime's in-sandbox runner.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": "github:eankhbayar/agent-runtime",
  "files": [
    "dist",
    "gateway"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./providers/docker": {
      "types": "./dist/providers/docker/index.d.ts",
      "default": "./dist/providers/docker/index.js"
    },
    "./pi/runner": {
      "types": "./dist/pi/runner/index.d.ts",
      "default": "./dist/pi/runner/index.js"
    },
    "./dispatch/cloud-run": {
      "types": "./dist/dispatch/cloud-run/index.d.ts",
      "default": "./dist/dispatch/cloud-run/index.js"
    },
    "./job": {
      "types": "./dist/job/index.d.ts",
      "default": "./dist/job/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contract.json && tsc -p tsconfig.dispatch.json",
    "test": "vitest run",
    "ready": "pnpm typecheck && pnpm test && pnpm build",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1",
    "typebox": "^1.3.30"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
